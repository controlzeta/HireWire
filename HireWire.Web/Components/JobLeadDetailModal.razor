@using HireWire.Domain.Entities
@using HireWire.Domain.Enums
@using HireWire.Application.Interfaces
@inject IJobLeadService JobLeadService
@inject IJSRuntime JSRuntime
@inject ICvGeneratorService CvGeneratorService
@inject ILogger<JobLeadDetailModal> Logger

@if (IsVisible && Lead != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-primary">💼 Detalle de Vacante: @Lead.JobTitle</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Fila de Detalles Rápidos -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Empresa:</strong> @Lead.Company.Name</p>
                            <p class="mb-1"><strong>Industria:</strong> @(Lead.Company.Industry ?? "No especificada")</p>
                            <p class="mb-1"><strong>Plataforma:</strong> <span class="badge @(Lead.Platform == "LinkedIn" ? "bg-info text-dark" : "bg-warning text-dark")">@Lead.Platform</span></p>
                            <p class="mb-1"><strong>Rango Salarial:</strong> @(Lead.SalaryRange ?? "No especificado")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Estado actual:</strong> <span class="badge bg-primary">@Lead.Status.ToString()</span></p>
                            <p class="mb-1"><strong>URL de Vacante:</strong> <a href="@Lead.Url" target="_blank" class="text-truncate d-inline-block" style="max-width: 250px;">@Lead.Url</a></p>
                            <p class="mb-1"><strong>Capturado el:</strong> @Lead.Company.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>

                    <hr />

                    <!-- Evaluación Automática con IA (Fase 2) -->
                    <div class="card mb-3 border-info shadow-sm">
                        <div class="card-header bg-info text-dark d-flex justify-content-between align-items-center py-2">
                            <h6 class="mb-0 fw-bold">🤖 Evaluación Automática con IA (Fase 2)</h6>
                            <button type="button" class="btn btn-sm btn-dark" @onclick="EvaluateWithAi" disabled="@isEvaluatingAi">
                                @if (isEvaluatingAi)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    <span>Evaluando con IA...</span>
                                }
                                else
                                {
                                    <span>⚡ Executar Evaluación IA</span>
                                }
                            </button>
                        </div>
                        <div class="card-body p-3">
                            <p class="small text-muted mb-2">Utiliza la API configurada (Claude, OpenAI, Gemini o Mock) para evaluar automáticamente el puesto, clasificarlo en J1 (Liderazgo) o J2 (Contribuidor Individual), calcular el match score y generar la propuesta de mensaje.</p>
                            
                            @if (!string.IsNullOrEmpty(generatedOutreachMessage))
                            {
                                <div class="mt-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label fw-bold text-dark mb-0" style="font-size: 13px;">📧 Mensaje de Outreach Sugerido por IA:</label>
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;" @onclick="CopyOutreachMessageToClipboard">
                                            📋 Copiar Mensaje
                                        </button>
                                    </div>
                                    <textarea class="form-control" style="font-size: 13px; background-color: #fff;" rows="4" @bind="generatedOutreachMessage"></textarea>
                                    @if (showOutreachCopiedAlert)
                                    {
                                        <div class="alert alert-success py-1 px-2 mt-2 mb-0" style="font-size: 12px;" role="alert">
                                            ¡Mensaje de outreach copiado al portapapeles!
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Prompt para IA Manual (Fase 1 Fallback) -->
                    <div class="card mb-3 bg-light">
                        <div class="card-header d-flex justify-content-between align-items-center py-2">
                            <h6 class="mb-0 text-dark">📝 Prompt Manual (Fase 1)</h6>
                            <button class="btn btn-sm btn-outline-secondary py-1" @onclick="CopyPromptToClipboard">
                                📋 Copiar Prompt
                            </button>
                        </div>
                        <div class="card-body p-2">
                            <textarea class="form-control text-muted" style="font-family: monospace; font-size: 12px; background-color: #f8f9fa;" rows="4" readonly>@GetAiPrompt()</textarea>
                            @if (showCopiedAlert)
                            {
                                <div class="alert alert-success py-1 px-2 mt-2 mb-0" style="font-size: 12px;" role="alert">
                                    ¡Prompt copiado al portapapeles!
                                </div>
                            }
                        </div>
                    </div>

                    <hr />

                    <!-- Formulario de Guardado de Evaluación de OE -->
                    <div class="card border-primary mb-3 shadow-sm">
                        <div class="card-header bg-primary text-white py-2">
                            <h6 class="mb-0">📋 Datos de Enrutamiento de Overemployment (OE)</h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">Rol Recomendado</label>
                                    <select class="form-select" @bind="targetRole">
                                        <option value="J1">J1 (Liderazgo / Arquitectura)</option>
                                        <option value="J2">J2 (Contribuidor Individual)</option>
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-bold">Coincidencia IA (0-100%)</label>
                                    <input type="number" class="form-control" @bind="aiMatchScore" min="0" max="100" />
                                </div>
                                <div class="col-md-4 mb-3 d-flex align-items-end">
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="isAsyncCheck" @bind="isAsync" />
                                        <label class="form-check-label fw-bold" for="isAsyncCheck">
                                            ¿Es Asíncrono?
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Red Flags Detectadas</label>
                                <textarea class="form-control" rows="2" placeholder="Ej. Micromanagement, guardias frecuentes, demasiadas reuniones diarias..." @bind="detectedRedFlags"></textarea>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger py-1 mt-2">@errorMessage</div>
                            }

                            <div class="d-flex justify-content-end">
                                <button type="button" class="btn btn-success px-4" @onclick="SaveEvaluation">💾 Guardar Evaluación</button>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <!-- Descripción de la Vacante -->
                    <div class="mb-3">
                        <h6 class="fw-bold">📄 Descripción Completa de la Vacante</h6>
                        <div class="p-3 border rounded bg-white shadow-sm" style="max-height: 220px; overflow-y: auto; white-space: pre-wrap; font-size: 13px; line-height: 1.5;">
                            @Lead.RawDescription
                        </div>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between bg-light">
                    <div>
                        <button type="button" class="btn btn-outline-primary btn-sm me-2 fw-bold" @onclick="GenerateResume" disabled="@isGeneratingCv">
                            @if (isGeneratingCv)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Generando CV...</span>
                            }
                            else
                            {
                                <span>📄 Generar CV PDF</span>
                            }
                        </button>

                        @if (hasGeneratedCv)
                        {
                            <a href="@cvDownloadPath" target="_blank" class="btn btn-info text-dark btn-sm me-2 fw-bold" download>
                                📥 Descargar CV PDF
                            </a>
                        }

                        @if (Lead.Status >= JobLeadStatus.EvaluadoPorIa)
                        {
                            <a href="/interview-cheat-sheet/@Lead.Id" target="_blank" class="btn btn-success btn-sm fw-bold me-2">
                                🎯 Cheat Sheet Entrevista
                            </a>
                        }

                        <button type="button" class="btn btn-outline-danger btn-sm fw-bold me-2" @onclick="ConfirmAndDeleteLead">
                            🗑️ Eliminar Vacante
                        </button>
                    </div>
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public JobLead? Lead { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string targetRole = "J1";
    private int? aiMatchScore = 80;
    private bool isAsync = false;
    private string? detectedRedFlags = "";
    private string errorMessage = "";
    private bool showCopiedAlert = false;
    
    private string? generatedOutreachMessage = "";
    private bool showOutreachCopiedAlert = false;

    private bool isEvaluatingAi = false;
    private bool isGeneratingCv = false;
    private bool hasGeneratedCv = false;
    private string cvDownloadPath = "";

    protected override void OnParametersSet()
    {
        if (Lead != null)
        {
            if (Lead.OE_Config != null)
            {
                targetRole = Lead.OE_Config.TargetRole.ToString();
                aiMatchScore = Lead.OE_Config.AiMatchScore.HasValue ? (int)Lead.OE_Config.AiMatchScore.Value : null;
                isAsync = Lead.OE_Config.IsAsync;
                detectedRedFlags = Lead.OE_Config.DetectedRedFlags;
            }
            else
            {
                targetRole = "J1";
                aiMatchScore = null;
                isAsync = false;
                detectedRedFlags = "";
            }

            if (Lead.Communications != null && Lead.Communications.Any())
            {
                generatedOutreachMessage = Lead.Communications.OrderByDescending(c => c.SentDate).FirstOrDefault()?.MessageBody;
            }
            else
            {
                generatedOutreachMessage = "";
            }

            hasGeneratedCv = Lead.InterviewAssets != null && Lead.InterviewAssets.Any(a => !string.IsNullOrEmpty(a.DynamicCvPath));
            cvDownloadPath = hasGeneratedCv ? $"/cvs/{Lead.Id}.pdf?t={DateTime.UtcNow.Ticks}" : "";

            errorMessage = "";
            showCopiedAlert = false;
            showOutreachCopiedAlert = false;
        }
    }

    private string GetAiPrompt()
    {
        if (Lead == null) return "";
        return JobLeadService.GetManualAiPrompt(Lead);
    }

    private async Task EvaluateWithAi()
    {
        if (Lead == null) return;
        isEvaluatingAi = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            var result = await JobLeadService.EvaluateLeadWithAiAsync(Lead.Id);
            targetRole = result.TargetRole.ToString();
            aiMatchScore = (int)result.AiMatchScore;
            isAsync = result.IsAsync;
            detectedRedFlags = result.DetectedRedFlags;
            generatedOutreachMessage = result.OutreachMessage;

            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al evaluar con IA para el JobLead {JobLeadId}", Lead.Id);
            errorMessage = "Error al evaluar con IA: " + ex.Message;
        }
        finally
        {
            isEvaluatingAi = false;
            StateHasChanged();
        }
    }

    private async Task CopyPromptToClipboard()
    {
        try
        {
            var prompt = GetAiPrompt();
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", prompt);
            showCopiedAlert = true;
            StateHasChanged();
            await Task.Delay(2000);
            showCopiedAlert = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = "No se pudo copiar automáticamente: " + ex.Message;
        }
    }

    private async Task CopyOutreachMessageToClipboard()
    {
        try
        {
            if (!string.IsNullOrEmpty(generatedOutreachMessage))
            {
                await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", generatedOutreachMessage);
                showOutreachCopiedAlert = true;
                StateHasChanged();
                await Task.Delay(2000);
                showOutreachCopiedAlert = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "No se pudo copiar el mensaje: " + ex.Message;
        }
    }

    private async Task SaveEvaluation()
    {
        if (Lead == null) return;

        try
        {
            errorMessage = "";
            TargetRole role = Enum.Parse<TargetRole>(targetRole);
            await JobLeadService.SaveOEConfigAsync(Lead.Id, role, aiMatchScore, isAsync, detectedRedFlags);
            await OnSaved.InvokeAsync();
            await CloseModal();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar la evaluación para el JobLead {JobLeadId}", Lead.Id);
            errorMessage = "Error al guardar: " + ex.Message;
        }
    }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync();
    }

    private async Task GenerateResume()
    {
        if (Lead == null) return;
        isGeneratingCv = true;
        errorMessage = "";
        StateHasChanged();
        try
        {
            await CvGeneratorService.GenerateCvAsync(Lead.Id);
            hasGeneratedCv = true;
            cvDownloadPath = $"/cvs/{Lead.Id}.pdf?t={DateTime.UtcNow.Ticks}";
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Error al generar el CV: " + ex.Message;
        }
        finally
        {
            isGeneratingCv = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmAndDeleteLead()
    {
        if (Lead == null) return;
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"¿Estás seguro de eliminar la vacante de {Lead.JobTitle} en {Lead.Company.Name}?");
        if (confirmed)
        {
            await JobLeadService.DeleteJobLeadAsync(Lead.Id);
            await OnSaved.InvokeAsync();
            await CloseModal();
        }
    }
}
